import random  # OBRIGATÓRIO: Importação do módulo de sorteio aleatório

# 1. DECLARAÇÃO DO BANCO DE PALAVRAS (Vocabulário do Jogo)
banco_palavras = ["PYTHON", "PROGRAMACAO", "ESTRUTURA", "ALGORITMO", "LOGICA"]

# 2. CONFIGURAÇÃO DE LIMITES DO JOGO
LIMITE_TENTATIVAS = 6  # Constante que define o máximo de erros permitidos
erros_cometidos = 0

def inicializar_jogo(lista_palavras):
    """Escolhe a palavra secreta e gera a lista de lacunas iniciais."""
    palavra = random.choice(lista_palavras).upper().strip()
    lacunas = ["_"] * len(palavra)
    return palavra, lacunas

def processar_tentativa(letra, palavra_secreta, palavra_lacunas):
    """Verifica a presença da letra e atualiza a lista de lacunas se houver acerto."""
    acertou = False
    for indice, caractere in enumerate(palavra_secreta):
        if caractere == letra:
            palavra_lacunas[indice] = letra
            acertou = True
    return acertou

# O fluxo principal se torna direto e intuitivo
palavra_alvo, lacunas_atuais = inicializar_jogo(banco_palavras)
tentativas = set()

print("=" * 50)
print("BEM-VINDO AO JOGO DA FORCA!")
print("=" * 50)

while erros_cometidos < LIMITE_TENTATIVAS:
    # Exibe interface
    print(f"\nPalavra: {' '.join(lacunas_atuais)}")
    print(f"Tentativas restantes: {LIMITE_TENTATIVAS - erros_cometidos}")
    print(f"Letras já digitadas: {', '.join(sorted(tentativas)) if tentativas else 'Nenhuma'}")
    
    chute = input("\nDigite uma letra: ").upper()
    
    # Validação: letra já digitada?
    if chute in tentativas:
        print("❌ Você já digitou essa letra! Tente outra.")
        continue
    
    tentativas.add(chute)
    
    # Chamada clara do processamento
    if not processar_tentativa(chute, palavra_alvo, lacunas_atuais):
        erros_cometidos += 1
        print(f"❌ Errado! A letra '{chute}' não está na palavra.")
    else:
        print(f"✓ Acertou! A letra '{chute}' está na palavra.")
    
    # Verificação de vitória
    if "_" not in lacunas_atuais:
        print("\n" + "=" * 50)
        print(f"🎉 PARABÉNS! Você venceu!")
        print(f"A palavra era: {palavra_alvo}")
        print("=" * 50)
        break

# Mensagem de derrota
if erros_cometidos >= LIMITE_TENTATIVAS and "_" in lacunas_atuais:
    print("\n" + "=" * 50)
    print(f"😞 GAME OVER! Você perdeu!")
    print(f"A palavra era: {palavra_alvo}")
    print("=" * 50)
